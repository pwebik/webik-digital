{
  "name": "StyleGuide",
  "type": "object",
  "properties": {
    "client_brief_id": {
      "type": "string",
      "description": "ID of the linked ClientBrief record"
    },
    "generated_prompt": {
      "type": "string",
      "description": "AI-generated style guide prompt based on the client intake"
    },
    "status": {
      "type": "string",
      "description": "Status of the generated style guide",
      "enum": [
        "draft",
        "final"
      ],
      "default": "draft"
    }
  },
  "required": [
    "client_brief_id"
  ]
}