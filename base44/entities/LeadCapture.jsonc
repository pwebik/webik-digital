{
  "name": "LeadCapture",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address of the lead"
    },
    "name": {
      "type": "string",
      "description": "Name of the lead (optional)"
    },
    "source": {
      "type": "string",
      "description": "Source of the lead capture",
      "default": "5-signs-guide"
    }
  },
  "required": [
    "email"
  ]
}